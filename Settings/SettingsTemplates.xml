<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<Frame name="SparkPointSettingsListSectionHintTemplate" mixin="SettingsListSectionHeaderMixin" virtual="true">
		<Size x="30" y="29"/>
		<Layers>
			<Layer level="OVERLAY">
				<FontString parentKey="Title" inherits="GameFontHighlightSmall" justifyH="LEFT" justifyV="TOP">
					<Anchors>
						<Anchor point="TOPLEFT" x="35" y="0"/>
						<Anchor point="TOPRIGHT" x="-20" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Frame parentKey="NewFeature" inherits="NewFeatureLabelTemplate" frameStrata="HIGH" scale="0.8" frameLevel="100" hidden="true">
				<Size x="1" y="1"/>
				<Anchors>
					<Anchor point="BOTTOMRIGHT" x="16" y="-10" relativeKey="$parent.Title" relativePoint="LEFT"/>
				</Anchors>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>

	<Frame name="SparkPointColorOverridesPanelNoHead"
		mixin="SparkPointColorOverridesMixin"
		inherits="SettingsListElementTemplate"
		virtual="true"
	>
		<Size x="200" y="25"/>
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Header" inherits="GameFontNormal" justifyH="LEFT">
					<Size x="0" y="0"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="37" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Frame parentKey="List" inherits="VerticalLayoutFrame">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.Header" relativePoint="BOTTOMLEFT" x="15" y="0"/>
				</Anchors>
				<KeyValues>
					<KeyValue key="spacing" value="10" type="number"/>
				</KeyValues>
			</Frame>
			<Frame parentKey="NewFeature" inherits="NewFeatureLabelTemplate" scale="0.8">
				<Anchors>
					<Anchor point="RIGHT" relativeKey="$parent.Header" relativePoint="LEFT" x="16" y="7"/>
				</Anchors>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>

	<!-- inherits="SettingsListElementTemplate" is REQUIRED. Blizzard's
	     SettingsListElementMixin:Init asserts on self.cbrHandles (created only in its
	     OnLoad) and then indexes self.Text (defined only by that template). Without the
	     inherit, the panel nil-errors the first time it is opened.
	     Matches SparkPointColorOverridesPanelNoHead above. -->
	<Frame name="SparkPointCooldownFilterPanelNoHead"
		mixin="SparkPointCooldownFilterMixin"
		inherits="SettingsListElementTemplate"
		virtual="true"
	>
		<Size x="280" y="200"/>
		<Frames>
			<ScrollFrame parentKey="ScrollFrame" inherits="ScrollFrameTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" x="8" y="-8"/>
					<Anchor point="BOTTOMRIGHT" x="-28" y="8"/>
				</Anchors>
				<ScrollChild>
					<Frame parentKey="Content">
						<Size x="250" y="1"/>
					</Frame>
				</ScrollChild>
			</ScrollFrame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>
</Ui>
